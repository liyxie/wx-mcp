# iLink Bot API 地址
WX_MCP_BASE_URL=https://ilinkai.weixin.qq.com

# MCP 传输方式：http（远程）或 stdio（本地）
WX_MCP_TRANSPORT=http
WX_MCP_HOST=127.0.0.1
WX_MCP_PORT=18080

# 账号数据目录（默认 wx-mcp/data）
WX_MCP_DATA_DIR=

# 发送到 base_info 的 UA 风格 bot_agent（可选）
WX_MCP_BOT_AGENT=

# /upload 原始文件大小上限（字节，默认 104857600）
WX_MCP_MAX_UPLOAD_BYTES=
